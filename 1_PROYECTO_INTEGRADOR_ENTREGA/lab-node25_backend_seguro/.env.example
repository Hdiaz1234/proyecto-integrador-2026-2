# Copiar a .env. Nunca subir .env a Git.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Supabase > Connect (Direct o Session Pooler).
# Si la clave de la base incluye @, #, : o /, codificarla en la URL (@ = %40, # = %23).
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
PGSSL=true
PGSSL_CA_PATH=./certs/supabase-ca.crt
PGPOOL_MAX=5

# Supabase > Project Settings
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=REEMPLAZAR_CON_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SECRET_KEY

# CORS y limite de intentos de login
FRONTEND_URL=http://localhost:5173
AUTH_RATE_LIMIT=20

LAB_DIAGNOSTICS_ENABLED=false
# Token aleatorio de 32 o mas caracteres
LAB_DIAGNOSTICS_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO